{
  "manifest_version": 3,
  "name": "Nutrition Info Extension",
  "version": "1.0",
  "description": "Get real-time nutrition analysis from food websites",
  "permissions": ["scripting", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["compromise.min.js", "config.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/sample.png",
      "48": "icons/sample.png",
      "128": "icons/sample.png"
    }
  }
}
